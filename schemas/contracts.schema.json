{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ah-design/contracts.schema.json",
  "title": "AH Design AI machine contract bundle",
  "type": "object",
  "required": [
    "components",
    "layouts",
    "policies",
    "pageProfiles"
  ],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version",
        "canonical",
        "components"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "version": {
          "type": "string"
        },
        "canonical": {
          "const": "docs/AH_DESIGN_v2.6.md"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "section",
              "scope"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "section": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "layouts": {
      "type": "object",
      "required": [
        "schemaVersion",
        "canonical",
        "shell",
        "pages"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "canonical": {
          "const": "docs/AH_DESIGN_v2.6.md"
        },
        "shell": {
          "type": "object",
          "required": [
            "desktop"
          ]
        },
        "pages": {
          "type": "object"
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "schemaVersion",
        "defaultMode",
        "modes",
        "pagePrecedence"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "defaultMode": {
          "const": "privacy-safe-skeleton"
        },
        "modes": {
          "type": "object",
          "required": [
            "privacy-safe-skeleton",
            "runtime-loading-skeleton"
          ]
        },
        "pagePrecedence": {
          "type": "object",
          "required": [
            "home",
            "operational",
            "priority"
          ]
        }
      }
    },
    "pageProfiles": {
      "type": "object",
      "required": [
        "schemaVersion",
        "canonical",
        "profiles",
        "precedenceSection"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "canonical": {
          "const": "docs/AH_DESIGN_v2.6.md"
        },
        "precedenceSection": {
          "const": "9.7"
        },
        "profiles": {
          "type": "object",
          "required": [
            "home-desktop",
            "operational-listing",
            "mobile-unknown"
          ]
        }
      }
    }
  }
}
