{
  "schemaVersion": "1.0",
  "version": "2.6",
  "canonical": "docs/AH_DESIGN_v2.6.md",
  "defaultMode": "privacy-safe-skeleton",
  "modes": {
    "privacy-safe-skeleton": {
      "requiresApprovedRuntimeData": false,
      "readableBusinessData": false,
      "readableNavigation": false,
      "semanticNavigationIcons": false,
      "defaultForDesignOnly": true
    },
    "runtime-loading-skeleton": {
      "requiresApprovedRuntimeData": true,
      "approvedStaticChromeOnly": true,
      "fallback": "privacy-safe-skeleton"
    },
    "synthetic-demo": {
      "requiresExplicitDemoRequest": true,
      "fictionalContentOnly": true,
      "separateFromDesignContracts": true,
      "productionReady": false
    }
  },
  "precedence": [
    "Canonical Markdown takes priority over machine indexes",
    "Apply explicit Home-only variations only on Home; preserve operational defaults",
    "When a global rule conflicts with a Home-specific rule, scope the exception and report ambiguity rather than silently inventing a rule",
    "Figma designs never authorize copying business/customer data"
  ],
  "knownGaps": [
    "Home skeleton observations are Desktop-only and are not a universal token scale",
    "Other Figma scenarios and mobile/tablet remain unverified"
  ],
  "precedenceSource": "docs/AH_DESIGN_v2.6.md §9.7",
  "pagePrecedence": {
    "priority": [
      "privacy-boundary",
      "explicit-page-variant",
      "operational-default",
      "responsive-no-invention"
    ],
    "home": {
      "mainSurface": "var(--ah-canvas)",
      "summarySurface": "var(--ah-primary-soft)",
      "searchWidthPx": 292,
      "sidebarLabelPx": 16
    },
    "operational": {
      "mainSurface": "var(--ah-app-bg)",
      "cardSurface": "var(--ah-canvas)",
      "searchWidthPx": 370,
      "sidebarLabelPx": 20
    }
  }
